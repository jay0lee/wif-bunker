# UTF-8
#
# Windows version info for WIF Bunker
# Template — placeholders replaced by build process:
#   {YEAR}, {MONTH}, {DAY}, {HHMM}, {VERSION_STR}
#
# For more details about fixed file info 'ffi' see:
# http://msdn.microsoft.com/en-us/library/ms646997.aspx
VSVersionInfo(
  ffi=FixedFileInfo(
    # filevers and prodvers should be always a tuple with four items: (1, 2, 3, 4)
    filevers=({YEAR}, {MONTH}, {DAY}, {HHMM}),
    prodvers=({YEAR}, {MONTH}, {DAY}, {HHMM}),
    # Contains a bitmask that specifies the valid bits 'flags'
    mask=0x3f,
    # Contains a bitmask that specifies the Boolean attributes of the file.
    flags=0x0,
    # The operating system for which this file was designed.
    # 0x4 - NT and there is no need to change it.
    OS=0x4,
    # The general type of file.
    # 0x1 - the file is an application.
    fileType=0x1,
    # The function of the file.
    # 0x0 - the function is not defined for this fileType
    subtype=0x0,
    # Creation date and time stamp.
    date=(0, 0)
  ),
  kids=[
    StringFileInfo(
      [
        StringTable(
          u'040904B0',
          [
            StringStruct(u'CompanyName', u'Jay Lee'),
            StringStruct(u'FileDescription', u'WIF Bunker — Hardware-backed Workload Identity Federation'),
            StringStruct(u'FileVersion', u'{VERSION_STR}'),
            StringStruct(u'InternalName', u'wif-bunker'),
            StringStruct(u'LegalCopyright', u'Copyright Jay Lee'),
            StringStruct(u'OriginalFilename', u'wif-bunker.exe'),
            StringStruct(u'ProductName', u'WIF Bunker'),
            StringStruct(u'ProductVersion', u'{VERSION_STR}'),
          ]
        )
      ]
    ),
    VarFileInfo([VarStruct(u'Translation', [1033, 1200])])
  ]
)
